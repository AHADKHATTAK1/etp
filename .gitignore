# ETechProvider — .gitignore
# Prevents secrets, build artifacts, and system files from being committed

# ── Secrets & Environment Variables ─────────────────────────────
.env
.env.local
.env.production
.env.development
*.key
*.pem
secrets.json

# ── Node Modules ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build Outputs ─────────────────────────────────────────────────
dist/
build/
.next/
out/

# ── OS Files ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ── IDE & Editor Files ───────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Logs ─────────────────────────────────────────────────────────
logs/
*.log

# ── Temporary Files ───────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
