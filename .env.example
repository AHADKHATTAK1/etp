# ETechProvider — Environment Variables Template
# Copy this to .env and fill in real values
# NEVER commit .env to git — it is in .gitignore

# ── EmailJS (for contact form & bot) ────────────────────────────
EMAILJS_PUBLIC_KEY=your_public_key_here
EMAILJS_SERVICE_ID=your_service_id_here
EMAILJS_TEMPLATE_ID=your_template_id_here

# ── Google Analytics ─────────────────────────────────────────────
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Tag Manager ───────────────────────────────────────────
GTM_ID=GTM-XXXXXXX

# ── Site Meta ────────────────────────────────────────────────────
SITE_URL=https://etechprovider.co.uk
CONTACT_EMAIL=info@etechprovider.co.uk
PHONE_PRIMARY=+44 7521 866654
